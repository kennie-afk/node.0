NODE_ENV=development
API_PORT=4000
INGESTION_PORT=4100

# Only used by docker-compose to bootstrap the postgres container itself; the app
# and migrations connect via DATABASE_URL/DATABASE_MIGRATION_URL below, not this.
POSTGRES_USER=forecourt
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=forecourt
POSTGRES_PORT=5432

DATABASE_URL=postgres://forecourt_app:change-me@localhost:5432/forecourt
DATABASE_MIGRATION_URL=postgres://forecourt:change-me-too@localhost:5432/forecourt
FORECOURT_APP_PASSWORD=change-me
DATABASE_POOL_MAX=20

JWT_SECRET=generate-a-random-value-of-at-least-32-characters
JWT_TTL_MINUTES=720

CORS_ORIGINS=http://localhost:5173

MPESA_CALLBACK_SECRET=set-a-shared-secret-for-the-daraja-callback
MPESA_ALLOWED_IPS=

LOG_LEVEL=info

DATABASE_SSL=false
DATABASE_CA_CERT=
LOGIN_RATE_LIMIT_PER_WINDOW=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
TELEMETRY_RATE_LIMIT_PER_MINUTE=120
CONSOLE_PORT=3300

# ---- Forecourt's own subscription billing (all PROVISIONAL) ----
# mock: owners can simulate paying from Billing; nothing real is collected. live: real M-Pesa
# confirmations arrive on BILLING_SHORTCODE through the same Daraja callback as the car-wash tills
# (BILLING_SHORTCODE is then required). There is no STK push: the owner pays the paybill with their
# account number.
BILLING_MODE=mock
# Production refuses mock unless this is true. For a real deployment: BILLING_MODE=live and delete this line.
BILLING_ALLOW_MOCK_IN_PRODUCTION=true
BILLING_SHORTCODE=
BILLING_PRICE_STARTER_KES=3500
BILLING_PRICE_GROWTH_KES=3000
BILLING_GROWTH_MAX_SITES=5
BILLING_TRIAL_DAYS=14
BILLING_ISSUE_LEAD_DAYS=3
BILLING_SUSPEND_AFTER_DAYS=14
BILLING_RUN_INTERVAL_MINUTES=60
# ---- signup verification ----
SIGNUP_CODE_TTL_MINUTES=15
SIGNUP_CODE_MAX_ATTEMPTS=5
SIGNUP_RESEND_COOLDOWN_SECONDS=60
# mock only logs the code (read it with `npm run admin -- messages`); no SMS provider is wired in
NOTIFY_PROVIDER=mock
API_RATE_LIMIT_PER_MINUTE=120
# ---- sessions ----
# How long the API trusts what it last read about an account (active, role, site, token version). A change made
# through the same process applies at once; another replica catches up within this many seconds. 0 = every request.
SESSION_CACHE_SECONDS=10
# ---- scheduled maintenance (hourly, from the API and the ingestion service; one replica runs it at a time) ----
MAINTENANCE_INTERVAL_MINUTES=60
# per-minute telemetry older than this is rolled into hourly rows and deleted
RETENTION_TELEMETRY_MINUTE_DAYS=35
# hourly telemetry is kept this long
RETENTION_TELEMETRY_HOUR_DAYS=800
# a raw-telemetry monthly partition is dropped once the whole month is older than this
RETENTION_TELEMETRY_RAW_DAYS=95
RETENTION_IDEMPOTENCY_DAYS=3
# ---- backups (scripts/backup.sh, docker compose --profile backup) ----
BACKUP_KEEP_DAYS=14
BACKUP_SKIP_RAW_TELEMETRY=0
BACKUP_INTERVAL_SECONDS=86400
