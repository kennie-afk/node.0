NODE_ENV=development
API_PORT=4000
INGESTION_PORT=4100

# Only used by docker-compose to bootstrap the postgres container itself; the app
# and migrations connect via DATABASE_URL/DATABASE_MIGRATION_URL below, not this.
POSTGRES_USER=forecourt
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=forecourt
POSTGRES_PORT=5432

DATABASE_URL=postgres://forecourt_app:change-me@localhost:5432/forecourt
DATABASE_MIGRATION_URL=postgres://forecourt:change-me-too@localhost:5432/forecourt
FORECOURT_APP_PASSWORD=change-me
DATABASE_POOL_MAX=20

JWT_SECRET=generate-a-random-value-of-at-least-32-characters
JWT_TTL_MINUTES=720

CORS_ORIGINS=http://localhost:5173

MPESA_CALLBACK_SECRET=set-a-shared-secret-for-the-daraja-callback
MPESA_ALLOWED_IPS=

LOG_LEVEL=info

DATABASE_SSL=false
DATABASE_CA_CERT=
LOGIN_RATE_LIMIT_PER_WINDOW=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
TELEMETRY_RATE_LIMIT_PER_MINUTE=120
CONSOLE_PORT=3300
