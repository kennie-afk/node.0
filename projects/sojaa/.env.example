# Copy to .env and fill in. Every value below that looks like a secret must be generated, not reused.
POSTGRES_USER=sojaa
POSTGRES_PASSWORD=change-me-generate-a-long-random-value
POSTGRES_DB=sojaa
# the restricted role the API connects as (created by the first migration); at least 12 characters
SOJAA_APP_PASSWORD=change-me-at-least-12-characters
JWT_SECRET=change-me-at-least-32-characters-long-random-value
# the M-Pesa confirmation URL you register with Safaricom is https://<your host>/v1/mpesa/c2b/<this secret>/confirmation
MPESA_CALLBACK_SECRET=change-me-at-least-16-chars

# Sojaa's own subscription (PROVISIONAL prices, whole shillings per month)
BILLING_MODE=mock
BILLING_ALLOW_MOCK_IN_PRODUCTION=true
BILLING_SHORTCODE=
BILLING_PRICE_PER_GUARD_KES=200
BILLING_MINIMUM_KES=3000
BILLING_TRIAL_DAYS=14
BILLING_SUSPEND_AFTER_DAYS=14

API_PORT=4400
POSTGRES_PORT=5442
CONSOLE_PORT=3900
CORS_ORIGINS=
