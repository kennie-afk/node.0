# Copy to .env and fill in. Every value below that looks like a secret must be generated, not reused.
POSTGRES_USER=hazina
POSTGRES_PASSWORD=change-me-generate-a-long-random-value
POSTGRES_DB=hazina
# the restricted role the API connects as (created by the first migration); at least 12 characters
HAZINA_APP_PASSWORD=change-me-at-least-12-characters
JWT_SECRET=change-me-at-least-32-characters-long-random-value
# the M-Pesa confirmation URL you register with Safaricom is https://<your host>/v1/mpesa/c2b/<this secret>/confirmation
MPESA_CALLBACK_SECRET=change-me-at-least-16-chars

# Hazina's own subscription (PROVISIONAL prices, whole shillings per month)
BILLING_MODE=mock
BILLING_ALLOW_MOCK_IN_PRODUCTION=true
BILLING_SHORTCODE=
BILLING_PRICE_SACCO_SMALL_KES=3500
BILLING_PRICE_SACCO_MEDIUM_KES=6000
BILLING_PRICE_LENDER_KES=10000
BILLING_TRIAL_DAYS=14
BILLING_SUSPEND_AFTER_DAYS=14

API_PORT=4300
POSTGRES_PORT=5441
CONSOLE_PORT=3800
# demo only: lets a signed-in person simulate an M-Pesa payment arriving on their paybill
MPESA_SIMULATOR=true
CORS_ORIGINS=

# ---- scheduled jobs and SMS (all optional) ----
# interest accrual and penalties run once a day after this hour, Nairobi time
DAILY_JOBS_HOUR=1
# also send instalment / arrears reminders as part of the daily jobs (needs a real provider)
SMS_REMINDERS_AUTO=false
# mock | africastalking. Africa's Talking is UNVERIFIED against the real service: try its sandbox first
NOTIFY_PROVIDER=mock
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_BASE_URL=https://api.africastalking.com
