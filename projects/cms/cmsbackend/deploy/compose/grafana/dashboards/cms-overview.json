{
 "uid": "cms-overview",
 "title": "Church CMS overview",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Requests / s by status",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (status) (rate(cms_http_request_duration_seconds_count[1m]))",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Latency p50 / p95 / p99",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum by (le) (rate(cms_http_request_duration_seconds_bucket[5m])))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(cms_http_request_duration_seconds_bucket[5m])))",
     "legendFormat": "p95",
     "refId": "B"
    },
    {
     "expr": "histogram_quantile(0.99, sum by (le) (rate(cms_http_request_duration_seconds_bucket[5m])))",
     "legendFormat": "p99",
     "refId": "C"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Slowest routes (p95)",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "topk(8, histogram_quantile(0.95, sum by (le, route) (rate(cms_http_request_duration_seconds_bucket[5m]))))",
     "legendFormat": "{{route}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Ledger postings / s",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (source_type) (rate(cms_ledger_postings_total[1m]))",
     "legendFormat": "{{source_type}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "DB pool (using / waiting)",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (state) (cms_db_pool_connections)",
     "legendFormat": "{{state}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Job queue depth",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "cms_jobs_queue_depth",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Oldest queued job age",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "max(cms_jobs_oldest_queued_age_seconds)",
     "legendFormat": "age",
     "refId": "A"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Jobs processed / s",
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (type, outcome) (rate(cms_jobs_processed_total[5m]))",
     "legendFormat": "{{type}} {{outcome}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Event loop lag",
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "nodejs_eventloop_lag_p99_seconds",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Heap used",
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "nodejs_heap_size_used_bytes",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ]
  }
 ],
 "tags": [
  "cms"
 ]
}