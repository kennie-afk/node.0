# Same-origin mode (recommended): one hostname serves the console AND the API (/api/*), so the browser
# makes no cross-origin preflight requests and there is no CORS to get wrong.
#
# SITE_ADDRESS   cms.example.com, or <ip>.sslip.io; Caddy gets and renews the certificate by itself.
#                Use "http://:80" for a local test with no certificate.
# TRUSTED_PROXIES  "127.0.0.1/32" = trust nobody (direct to the internet), or Cloudflare's published ranges when proxied (see README).
{
	admin off
	email {$ACME_EMAIL:admin@localhost}
	servers {
		protocols h1 h2 h3
		# Only believe forwarded-client headers from proxies we named; otherwise the client is the peer.
		trusted_proxies static {$TRUSTED_PROXIES}
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
	}

	# API. The /api prefix is stripped, as the console's own nginx used to do.
	handle_path /api/* {
		reverse_proxy api:4400 {
			# One value, the real client address: the API trusts exactly one proxy hop, and rate
			# limits are per client address.
			header_up X-Forwarded-For {client_ip}
			header_up -X-Real-IP
			flush_interval -1
			transport http {
				dial_timeout 3s
				response_header_timeout 60s
				keepalive 2m
				keepalive_idle_conns 64
			}
			lb_try_duration 2s
		}
		header Cache-Control "no-store"
	}

	handle /healthz {
		respond "ok" 200
	}

	# Hashed files never change, so they are cached for a year. A file that does not exist (a stale page
	# asking for an old release's asset) is a plain 404 that is never cached, NOT the console's index.html.
	handle /assets/* {
		root * /srv
		@present file
		header @present Cache-Control "public, max-age=31536000, immutable"
		file_server {
			precompressed br gzip
		}
	}

	# Everything else is the single-page console: unknown paths get index.html (the router handles them),
	# and index.html itself is always revalidated so a new release is picked up at once.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server {
			precompressed br gzip
		}
	}

	log {
		output stdout
		format console
		level WARN
	}
}
